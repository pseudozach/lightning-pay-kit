{
  "name": "lightning-pay-kit",
  "version": "0.2.1",
  "description": "Accessible React payment-help UI for BOLT11 Lightning invoices.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pseudozach/lightning-pay-kit.git"
  },
  "homepage": "https://pseudozach.github.io/lightning-pay-kit/",
  "bugs": {
    "url": "https://github.com/pseudozach/lightning-pay-kit/issues"
  },
  "keywords": ["bitcoin", "lightning", "bolt11", "react", "payments"],
  "type": "module",
  "sideEffects": ["./dist/styles.css"],
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./providers.json": "./dist/providers.json",
    "./providers.schema.json": "./dist/providers.schema.json",
    "./payment-routes.json": "./dist/payment-routes.json",
    "./payment-routes.schema.json": "./dist/payment-routes.schema.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup --config tsup.config.ts && cp src/styles.css dist/styles.css && cp ../core/src/data/providers.json ../core/src/data/providers.schema.json dist/ && cp ../core/src/data/payment-routes.json ../core/src/data/payment-routes.schema.json dist/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@scure/base": "^1.2.6",
    "zod": "^4.1.11"
  },
  "peerDependencies": {
    "react": ">=17 <20",
    "react-dom": ">=17 <20"
  },
  "devDependencies": {
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}

